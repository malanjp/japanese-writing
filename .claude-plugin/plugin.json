{
  "name": "japanese-writing",
  "version": "0.2.0",
  "description": "日本語文章の推敲・自己適用スキル。SessionStart/UserPromptSubmit フックでゲート監視と短アンカー注入によりドリフトを防ぐ。既定は watch（日本語長文・推敲依頼時のみリマインダ）。出力モード quick/review/strict。規則の正本は SKILL.md。",
  "author": {
    "name": "malanjp",
    "url": "https://github.com/malanjp"
  },
  "homepage": "https://github.com/malanjp/japanese-writing",
  "repository": "https://github.com/malanjp/japanese-writing",
  "license": "MIT",
  "keywords": [
    "japanese",
    "writing",
    "proofreading",
    "editing",
    "hooks",
    "skills"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/japanese-writing-activate.js\"",
            "timeout": 5,
            "statusMessage": "japanese-writing 読込中..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/japanese-writing-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "japanese-writing 追跡中..."
          }
        ]
      }
    ]
  }
}
